# Copy to .env in this same folder (infrastructure/docker/.env) to
# override the docker-compose defaults. Values here should match
# apps/api/.env's DATABASE_URL/REDIS_URL credentials.

POSTGRES_USER=za_store
POSTGRES_PASSWORD=za_store_dev_password
POSTGRES_DB=za_store
POSTGRES_PORT=5432

REDIS_PORT=6379

MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
