# Copy to .env.local and adjust as needed.

# Base URL of the ZA API INCLUDING its /v1 prefix. The local default below only applies to
# `next dev` and tests. Production builds REQUIRE this (there is no localhost fallback), and on
# Netlify it must be a public https URL. The build also prerenders /about, /faq, /privacy-policy,
# /terms-of-service and /sitemap.xml from this API, so the API must be reachable from the build
# environment (scripts/check-api.mjs verifies that before `next build`). The API's CORS_ORIGIN
# must include this storefront's deployed origin.
NEXT_PUBLIC_API_URL=http://localhost:4000/v1
# Used for canonical URLs / OpenGraph tags / sitemap.xml (ADR 0022 §7). Deployed origin, no trailing
# slash. Required for production builds.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Used only by `pnpm test:e2e` (Playwright) — a customer account that
# can log in against NEXT_PUBLIC_API_URL. The E2E auth-setup project
# registers this account on first run if it doesn't already exist.
E2E_CUSTOMER_EMAIL=e2e-customer@za-store.test
E2E_CUSTOMER_PASSWORD=E2ECustomerPassword1234
