# Copy to .env and adjust as needed. See docs in the root README for details.

NODE_ENV=development
PORT=4000
API_GLOBAL_PREFIX=v1

# Comma-separated list of allowed origins. 3010/3011 are the storefront/admin
# Playwright E2E webServer ports (each app's playwright.config.ts), not just
# their normal dev ports.
CORS_ORIGIN=http://localhost:3000,http://localhost:3001,http://localhost:3010,http://localhost:3011

LOG_LEVEL=info

# Matches infrastructure/docker/docker-compose.yml's postgres service.
DATABASE_URL=postgresql://za_store:za_store_dev_password@localhost:5432/za_store?schema=public

# Matches infrastructure/docker/docker-compose.yml's redis service.
REDIS_URL=redis://localhost:6379

# Epic 7 (Authentication & Authorization) — HS256 signing secrets for
# access/refresh JWTs. Generate real random values per environment, e.g.
# `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`.
# Never reuse the same value for both, and never commit real secrets.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Epic 8 (Customer Accounts) — separate secrets from the staff ones above.
CUSTOMER_JWT_ACCESS_SECRET=
CUSTOMER_JWT_REFRESH_SECRET=

# Consumed only by `pnpm db:seed` (prisma/seed.ts) to bootstrap the one
# Super Admin account every deployment needs, per
# docs/product/23-ROLES-PERMISSIONS.md ("at least one Super Admin must
# always exist"). Not read by the running application itself.
BOOTSTRAP_SUPER_ADMIN_EMAIL=admin@za-store.local
BOOTSTRAP_SUPER_ADMIN_PASSWORD=ChangeThisPassword123

# Optional. Pins StoreContext to a specific Store row (per
# docs/v2/adr/0006 and docs/v2/adr/0012). If unset, StoreContext falls
# back to the single seeded Store row automatically — fine for local
# development where exactly one Store ever exists.
# DEFAULT_STORE_ID=

# Epic 11 (Commerce Services) — see docs/v2/adr/0024. Defaults already
# match infrastructure/docker/docker-compose.yml's mailpit service, so
# `pnpm docker:up` is all local dev needs to send/view real emails at
# http://localhost:8025. Point these at a real provider (SES, Postmark,
# Resend's SMTP relay, etc.) in production.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=ZA Store <no-reply@za-store.local>

# Where admin-facing notification emails (new order, review awaiting
# moderation) are sent, and where a staff password-reset email links to.
# Falls back to the seeded bootstrap Super Admin's email if unset.
STORE_ADMIN_NOTIFICATION_EMAIL=
ADMIN_APP_URL=http://localhost:3001

# Epic 12 (Payments & Shipping) — see docs/v2/adr/0026. Defaults are
# Stripe's own test-mode placeholders; card checkout needs real test keys
# from https://dashboard.stripe.com/test/apikeys and a webhook secret from
# `stripe listen --forward-to localhost:4100/v1/payments/webhooks/stripe`.
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_test_placeholder
STOREFRONT_APP_URL=http://localhost:3000
