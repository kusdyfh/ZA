# Copy to .env.local and adjust as needed.

NEXT_PUBLIC_API_URL=http://localhost:4000/v1

# Used only by `pnpm test:e2e` (Playwright) — an admin account that can
# log in against NEXT_PUBLIC_API_URL. Defaults to the seeded bootstrap
# Super Admin (apps/api's BOOTSTRAP_SUPER_ADMIN_EMAIL/PASSWORD) if unset.
E2E_ADMIN_EMAIL=admin@za-store.local
E2E_ADMIN_PASSWORD=ChangeThisPassword123
